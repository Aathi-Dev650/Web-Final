# Never commit your real Atlas password or this completed file.
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
MONGODB_URI=mongodb+srv://<username>:<url-encoded-password>@<cluster-url>/?retryWrites=true&w=majority
MONGODB_DATABASE=cropcure
DISEASE_MODEL_PATH=ml/artifacts/disease_model.keras
DISEASE_LABELS_PATH=ml/artifacts/class_names.json
